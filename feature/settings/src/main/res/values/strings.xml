    <string name="settings_reset_title">Reset all data?</string>
    <string name="settings_reset_body">This deletes your habits, history, XP, level, PawCoins, accessories, achievements and settings from this device. It cannot be undone. You may want to export your data first.</string>
    <string name="settings_reset_final_title">Are you sure?</string>
