<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: habits, progress and preferences are included in the user's own
     Google account backup and in device-to-device transfer. Described in the privacy text. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
